From af0bfa83764d269fcfb213c238c3ea39c5a93a20 Mon Sep 17 00:00:00 2001
From: Yuno <Challa.somesh@gmail.com>
Date: Tue, 20 Oct 2026 01:04:44 +0530
Subject: [PATCH 2/3] fix(jellyfin): short timeout for badge-pack System/Info
 lookup

System/Info must not wait on the stream addon's full stream timeout.
---
 addon/lib/jellyfin/badgePacks.ts | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/addon/lib/jellyfin/badgePacks.ts b/addon/lib/jellyfin/badgePacks.ts
index f81692fd..764f01ca 100644
--- a/addon/lib/jellyfin/badgePacks.ts
+++ b/addon/lib/jellyfin/badgePacks.ts
@@ -60,9 +60,11 @@ export async function badgePacksForConfig(config: any | null | undefined): Promi
   const cached = cache.get(infoUrl);
   if (cached) return cached;
 
+  // Keep this short — System/Info must not stall the whole Jellyfin handshake.
+  const timeoutMs = envInt('JELLYFIN_BADGE_PACK_TIMEOUT_MS', 2500, 250);
   try {
     const controller = new AbortController();
-    const timer = setTimeout(() => controller.abort(), envInt('JELLYFIN_STREAM_TIMEOUT_MS', 15000, 1000));
+    const timer = setTimeout(() => controller.abort(), timeoutMs);
     try {
       const response = await fetch(infoUrl, {
         headers: { accept: 'application/json' },
-- 
